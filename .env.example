# AstroSight Environment Configuration
# Copy this file to .env and adjust variables as needed

# Security Key for JWT session tokens (generate a strong random string)
ASTROSIGHT_SECRET_KEY=astrosight-super-secret-key-deep-space-orbital-2026

# Token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Persistent data directories
DATA_DIR=./data
UPLOAD_DIR=./uploads
REPORT_DIR=./reports

# Database URL (SQLite or PostgreSQL)
# SQLite:
DATABASE_URL=sqlite:///./data/astrosight.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/astrosight

# Allowed CORS Origins (comma-separated or * for public access)
CORS_ORIGINS=*

# Server Port
PORT=8000
